MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_SERVER=your_server_name
MSSQL_DATABASE=your_database_name
MSSQL_USERNAME=your_database_username
MSSQL_PASSWORD=your_database_password
MSSQL_WINDOWS_AUTH=false
MSSQL_ENCRYPT=yes
MSSQL_TRUST_SERVER_CERTIFICATE=no
MSSQL_APPLICATION_NAME=Nexus
MSSQL_CONNECTION_TIMEOUT=15
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATASOURCE_ENCRYPTION_KEY=generate_a_fernet_key_and_put_it_here
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_SECONDS=43200
